# Custom CMS (single source of truth — Supabase-backed at cms.rampurnews.com)
NEXT_PUBLIC_CUSTOM_CMS_URL=https://cms.rampurnews.com
CUSTOM_CMS_URL=https://cms.rampurnews.com

# Internal URL for server-side fetches (REQUIRED on production)
# Set to the CMS's internal address to avoid DNS hairpin issues
# when frontend and CMS are on the same server.
CUSTOM_CMS_INTERNAL_URL=http://localhost:3000

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://rampurnews.com

# Server-side absolute URL used for SSR fetches
SITE_URL=https://rampurnews.com

# Preview mode secret — must match PREVIEW_SECRET in CMS .env
PREVIEW_SECRET=your-preview-secret-here

# Google Search Console HTML-tag verification token (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=google0abe644ab91d1cc5

# ISR revalidation secret — must match REVALIDATE_SECRET in CMS .env
# Used by /api/revalidate to authenticate on-demand cache purge requests
REVALIDATE_SECRET=your-revalidate-secret-here

# Facebook Page ID (for fb:pages meta tag — improves link preview priority)
NEXT_PUBLIC_FB_PAGE_ID=
