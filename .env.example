# Strapi CMS URL (client + server)
# Use full URL including protocol and /api
NEXT_PUBLIC_STRAPI_URL=https://api.rampur.cloud/api
STRAPI_API_URL=https://api.rampur.cloud/api

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://rampurnews.com

# Server-side absolute URL used by buildProxyUrl for SSR fetches
SITE_URL=https://rampurnews.com

# Preview mode secret — must match PREVIEW_SECRET in Strapi .env
PREVIEW_SECRET=your-preview-secret-here

# Google Search Console HTML-tag verification token (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=google0abe644ab91d1cc5

# ISR revalidation secret — must match REVALIDATE_SECRET in Strapi and CMS .env
# Used by /api/revalidate to authenticate on-demand cache purge requests
REVALIDATE_SECRET=your-revalidate-secret-here
